{
  "name": "gitflic-cli",
  "version": "0.1.0",
  "description": "Lightweight CLI for GitFlic REST API (gitflic.ru) — focus on merge requests, discussions and reviews. Zero external dependencies.",
  "type": "module",
  "private": true,
  "bin": {
    "gitflic": "bin/gitflic"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node lib/gitflic.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "node scripts/serve-docs.mjs",
    "docs:build": "echo \"Docsify is build-free. Push docs/ to your Pages branch.\" && exit 0",
    "lint": "node -e \"for (const f of ['lib/gitflic.mjs', ...require('fs').readdirSync('lib').filter(x=>x.endsWith('.mjs')), ...require('fs').readdirSync('lib/cmd').filter(x=>x.endsWith('.mjs')).map(x=>'lib/cmd/'+x), ...require('fs').readdirSync('mcp-server').filter(x=>x.endsWith('.mjs')).map(x=>'mcp-server/'+x)]) { require('child_process').execSync('node --check '+f, {stdio:'inherit'}); }\""
  },
  "license": "MIT",
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
