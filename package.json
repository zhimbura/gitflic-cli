{
  "name": "gitflic-cli",
  "version": "0.3.0",
  "description": "Lightweight zero-dependency CLI for the full GitFlic REST API (gitflic.ru) — 100% endpoint coverage.",
  "type": "module",
  "private": true,
  "bin": {
    "gitflic": "bin/gitflic"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node lib/gitflic.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "node scripts/serve-docs.mjs",
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "lint": "node scripts/build.mjs --no-test --no-bundle"
  },
  "license": "MIT",
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
