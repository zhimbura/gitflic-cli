# GitFlic CLI — access token
# Get yours at https://gitflic.ru -> Profile -> API tokens
# GITFLIC_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: override API base for self-hosted GitFlic
# GITFLIC_API_BASE=https://api.gitflic.ru

# Timeweb Cloud API token (for docs deploy via scripts/twc-upload.mjs)
# Get yours at https://timeweb.cloud/my/api-keys
# TIMWEB_API_TOKEN=eyJ...
